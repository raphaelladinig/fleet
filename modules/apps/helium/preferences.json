{
  "helium": {
    "browser": {
      "layout": 2,
      "vertical_right_aligned": true
    },
    "services": {
      "disable_schema_alerts": true,
      "enabled": true,
      "ext_proxy": true
    }
  },
  "browser": {
    "theme": {
      "is_grayscale2": true
    }
  },
  "spellcheck": {
    "dictionaries": [
      "en-US"
    ]
  },
  "intl": {
    "selected_languages": "en-US,en"
  },
  "accessibility": {
    "captions": {
      "headless_caption_enabled": false
    }
  }
}
